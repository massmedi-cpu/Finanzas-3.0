# Private application access. Use long, unique values in the deployment environment.
APP_ACCESS_PASSWORD=
APP_SESSION_SECRET=

# Google Sheets master source. Read-only scope only.
# Never commit real credentials or private spreadsheet identifiers.
GOOGLE_SHEETS_SOURCE_ID=
GOOGLE_SHEETS_SOURCE_RANGE=A:V
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
