# Financial App — variables públicas necesarias para el cliente SSR de Supabase.
# No incluir secretos ni credenciales privadas en este archivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth se configura en Supabase Auth con Client ID/Secret server-side.
# Financial App no utiliza contraseñas propias ni expone secretos de Google al navegador.
